build/
dist/

# ==============================================================================
# Recommendation System & Datasets
# ==============================================================================
# Important: We DO NOT globally ignore .csv, .tsv, or ML models (.pkl, .pth)
# because they may be required for the recommendation system to run in deployment.
# Only ignore specific large/generated datasets or models that exceed Git limits (100MB).
# Examples of how to safely ignore specific large files/folders:
# /datasets/generated_large_data.csv
# /models/large_model.pth
# /data/temp/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# ==============================================================================
# Secrets & Environment Variables
# ==============================================================================
# Core environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# API keys and credentials
*.pem
*.key
client_secret.json
credentials.json

